root = Stack([Stack([Card([Metric("Revenue", $summary.revenue, "Current quarter")]), Card([Metric("Open items", $summary.open, "Across the team")])], "row"), Card([Heading("Work in progress"), Table([{key:"name",label:"Item"},{key:"owner",label:"Owner"},{key:"status",label:"Status"}], $work, "Team activity")]), Card([Heading("Revenue trend"), BarChart($revenue.labels, [Series("Revenue", $revenue.values)], "grouped")]), Card([Markdown($notes)])])
