{
  "name": "cowchat-site",
  "private": true,
  "scripts": {
    "sync:skill-assets": "mkdir -p public && cp ../skills/cowchat/SKILL.md public/skills.txt && cp ../SKILLS.md public/protocol.txt",
    "predev": "npm run sync:skill-assets",
    "dev": "next dev",
    "prebuild": "npm run sync:skill-assets",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:skill-assets": "node scripts/verify-skill-assets.mjs"
  },
  "dependencies": {
    "next": "^15.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3"
  }
}
